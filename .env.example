# Copy to .env and fill in. .env is git-ignored.
# Any OpenAI-compatible endpoint works. Retrieval, ingest and the ablation run without a key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Optional: a different model for the answer-eval judge (defaults to CHAT_MODEL)
# JUDGE_MODEL=
